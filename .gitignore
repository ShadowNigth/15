# Godot 4+ local cache & export builds
.godot/
export/
*.import.tmp

# Python bytecode & virtualenvs
__pycache__/
*.pyc
.venv/

# Development source caches, never part of editable releases
.cache/

# Development-only agent conversion dependencies
node_modules/
tools/source/modern_agents/msc.cjs

# Models, maps, textures and sounds are versioned as compressed archives in
# packs/ (see docs/ASSET_PACKS.md). assets/ is rebuilt by
# `python tools/pak.py unpack`; only the shaders stay as plain files.
/assets/*
!/assets/shaders/
/packs/.local_state.json
