#!/bin/sh
# Lanzador del Godot 4.3 que vive dentro del repositorio.
#
# El binario se guarda comprimido (xz) en tools/godot/ y se descomprime la
# primera vez que se usa en .cache/godot/, que está fuera de Git y de las
# instantáneas del entorno. Ver tools/godot/README.md.
#
#   tools/godot/godot --version
#   tools/godot/godot --headless --path . --import
#   tools/godot/godot --headless --path . --fixed-fps 60 res://tests/X.tscn
set -e

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$here/../.." && pwd)
name=godot-4.3-stable-linux-x86_64
cache="$root/.cache/godot"
bin="$cache/$name"
archive="$here/$name.xz"

if [ ! -x "$bin" ]; then
	mkdir -p "$cache"
	if [ ! -f "$archive" ]; then
		echo "No existe $archive." >&2
		echo "Regeneralo con: python3 tools/godot/bootstrap.py" >&2
		exit 1
	fi
	echo "[godot] descomprimiendo el motor en .cache/godot/ (solo la primera vez)..." >&2
	if command -v xz >/dev/null 2>&1; then
		xz -dc "$archive" > "$bin.part"
	else
		python3 - "$archive" "$bin.part" <<'PY'
import lzma, shutil, sys
with lzma.open(sys.argv[1], 'rb') as src, open(sys.argv[2], 'wb') as dst:
    shutil.copyfileobj(src, dst, 1 << 20)
PY
	fi
	chmod +x "$bin.part"
	mv "$bin.part" "$bin"
fi

exec "$bin" "$@"
